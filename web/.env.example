# Required database connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Use Neon’s non-pooler hostname for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-HOST/DATABASE?sslmode=require"

# Better Auth: generate a long random value and set the public app URL in production.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
